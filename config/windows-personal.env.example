# Copy to config/qq-only.env. Fill in your own QQ IDs and random tokens.
CODEX_REMOTE_CONTACT_HOST=127.0.0.1
CODEX_REMOTE_CONTACT_PORT=3789
CODEX_REMOTE_CONTACT_DISABLE_AUTH=0
CODEX_REMOTE_CONTACT_OWNER_QQ_ID=
CODEX_REMOTE_CONTACT_BOT_QQ_ID=
CODEX_REMOTE_CONTACT_ENGINE=codex
# Optional Gemini backend, so replies do not use the Codex subscription.
# Create a key at https://aistudio.google.com/apikey and keep it in this ignored file.
# CODEX_REMOTE_CONTACT_ENGINE=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# CODEX_REMOTE_CONTACT_GEMINI_API_KEY= and CODEX_REMOTE_CONTACT_GEMINI_MODEL= are accepted aliases.
# By default Gemini receives the same persona and gateway rules as the other engines.
# GEMINI_PERSONA_FILE=config/private/gemini-persona.txt
# GEMINI_PERSONA_MODE=append
CODEX_REMOTE_CONTACT_PERSONAL_MODE=1
CODEX_REMOTE_CONTACT_API_TOKEN=
ONEBOT_ACCESS_TOKEN=
ONEBOT_API_BASE=http://127.0.0.1:3000
